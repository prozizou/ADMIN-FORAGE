{
  "name": "asufor-scripts",
  "version": "1.0.0",
  "private": true,
  "description": "Scripts de maintenance ASUFOR (migration des arriérés, migration multi-forage)",
  "type": "commonjs",
  "scripts": {
    "test": "node billing.test.js && node crypto.test.js && node integration.test.js && node v5.test.js",
    "migrate-passcodes": "node migrate-passcodes.js --dry-run --service-account ./serviceAccountKey.json --db-url https://asufor-67a06-default-rtdb.firebaseio.com",
    "migrate-passcodes-apply": "node migrate-passcodes.js --apply --service-account ./serviceAccountKey.json --db-url https://asufor-67a06-default-rtdb.firebaseio.com",
    "migrate-auth": "node migrate-auth-passwords.js --dry-run --service-account ./serviceAccountKey.json --db-url https://asufor-67a06-default-rtdb.firebaseio.com --pins ./pins.json",
    "migrate-auth-apply": "node migrate-auth-passwords.js --apply --service-account ./serviceAccountKey.json --db-url https://asufor-67a06-default-rtdb.firebaseio.com --pins ./pins.json",
    "dry-run": "node migrate-arrears.js --dry-run --active ./active.json --backup ./backup.json --report ./rapport-arrieres.csv",
    "apply": "node migrate-arrears.js --apply --service-account ./serviceAccountKey.json --db-url https://asufor-67a06-default-rtdb.firebaseio.com",
    "forage-dry-run": "node migrate-multi-forage.js --dry-run --agents ./db_agents.json --compteurs ./asufor_db_diandioly.json --backup ./asufor_backup.json --depenses ./asufor_depenses.json",
    "forage-apply": "node migrate-multi-forage.js --apply --service-account ./serviceAccountKey.json --db-url https://asufor-67a06-default-rtdb.firebaseio.com",
    "init-counter": "node init-counter-number.js --dry-run --service-account ./serviceAccountKey.json --db-url https://asufor-67a06-default-rtdb.firebaseio.com --forage-key Asufor_diandioly",
    "init-counter-apply": "node init-counter-number.js --apply --service-account ./serviceAccountKey.json --db-url https://asufor-67a06-default-rtdb.firebaseio.com --forage-key Asufor_diandioly",
    "test:rules": "npm --prefix rules-test test",
    "test:smoke": "npm --prefix smoke test"
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "optionalDependencies": {
    "firebase-admin": "^12.0.0"
  }
}
