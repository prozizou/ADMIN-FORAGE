{
  "rules": {
    // ──────────────────────────────────────────────────────────────
    //  ASUFOR Diandioly — Règles de sécurité Realtime Database
    //  BROUILLON à TESTER avant déploiement (firebase deploy --only database)
    //
    //  Les rôles sont ici déduits de l'e-mail du compte Firebase Auth :
    //    président  -> president@diandioly.com
    //    secrétaire -> secretaire@diandioly.com
    //    trésorier  -> tresorier@diandioly.com
    //
    //  ⚠️  RECOMMANDATION : à terme, remplacer ces tests d'e-mail par des
    //      "custom claims" (auth.token.role == 'president', etc.) posés via
    //      l'Admin SDK / une Cloud Function. C'est plus robuste qu'un e-mail.
    // ──────────────────────────────────────────────────────────────

    // Refus par défaut : rien n'est lisible/inscriptible hors des noeuds déclarés.
    ".read": false,
    ".write": false,

    // ============ AGENTS (relevés terrain) ============
    "db_agents": {
      // Lecture : tout admin authentifié (le formulaire compteur liste les agents).
      ".read": "auth != null",

      // Écriture : création/gestion réservée au président et au secrétaire.
      ".write": "auth != null && (auth.token.email == 'president@diandioly.com' || auth.token.email == 'secretaire@diandioly.com')",

      // Index requis par la vérification de doublon (orderByChild('agent_tel')).
      ".indexOn": ["agent_tel"],

      "$agentId": {
        ".validate": "newData.hasChildren(['agent', 'agent_tel', 'passcode', 'zone'])",
        "agent":      { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100" },
        "agent_tel":  { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{7,15}$/)" },
        // ⚠️  passcode encore en clair : valider le format en attendant un hachage côté serveur.
        "passcode":   { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{6}$/)" },
        "zone":       { ".validate": "newData.isString() && newData.val().length <= 100" },
        "siege":      { ".validate": "newData.isString()" },
        "agent_id":   { ".validate": "newData.isString()" },
        // ⚠️  Données réelles : les 6 agents existants ont ce champ avec un ESPACE
        // ("agent id") au lieu de "agent_id" — un export Firebase confirmé l'a
        // montré. Toléré explicitement pour ne pas bloquer leurs futures écritures ;
        // les nouveaux agents créés par agents/agent.html utilisent "agent_id".
        "agent id":   { ".validate": "newData.isString()" },
        "key":        { ".validate": "newData.isString()" },
        "id_source":  { ".validate": "newData.isString()" },
        "created_at": { ".validate": "newData.isString()" },
        // Tout autre champ inattendu est refusé (verrouille le schéma agent).
        "$other":     { ".validate": false }
      }
    },

    // ============ COMPTEURS / RELEVÉS (cycle courant) ============
    // ⚠️ Noeud "asufor_db_diandioly" RETIRÉ (ex-Phase 4/étape 6 du runbook,
    // voir docs/MULTI-FORAGE.md) : les compteurs de Diandioly vivent désormais
    // sous Asufor/Asufor_diandioly/compteurs (LEGACY = false, forage-context.js).
    // Après suppression du noeud legacy en base (console Firebase / Admin SDK),
    // ce refus par défaut (".read"/".write": false à la racine) s'applique — plus
    // aucune règle ne couvre ce chemin, intentionnellement.

    // ============ ARCHIVES DE CYCLE (reset/clôture) ============
    "asufor_backup": {
      // Lecture : tous les rôles authentifiés (consultation des cycles passés).
      ".read": "auth != null",
      // Écriture : président uniquement (opération irréversible de clôture).
      ".write": "auth != null && auth.token.email == 'president@diandioly.com'",
      "$cycle": {
        ".validate": "newData.hasChildren(['donnees'])"
      }
    },

    // ============ DÉPENSES / CAISSE (par cycle "YYYY-MM") ============
    "asufor_depenses": {
      // Lecture : tous les rôles authentifiés (le bilan/caisse est consultable).
      ".read": "auth != null",
      "$cycle": {
        // Écriture (ajout/suppression) : président et trésorier uniquement (finance).
        ".write": "auth != null && (auth.token.email == 'president@diandioly.com' || auth.token.email == 'tresorier@diandioly.com')",
        "$depId": {
          ".validate": "newData.hasChildren(['libelle', 'montant'])",
          "libelle":    { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120" },
          "montant":    { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "date":       { ".validate": "newData.isString()" },
          "categorie":  { ".validate": "newData.isString()" },
          "created_by": { ".validate": "newData.isString()" },
          "created_at": { ".validate": "newData.isString()" },
          // Verrouille le schéma : tout autre champ est refusé.
          "$other":     { ".validate": false }
        }
      }
    },

    // ══════════════════════════════════════════════════════════════
    //  MULTI-FORAGE — ADDITIF : les noeuds legacy ci-dessus restent actifs
    //  pour la connexion actuelle (Diandioly, tant que non migré). Ces
    //  noeuds préparent/portent la bascule (voir docs/MULTI-FORAGE.md).
    //
    //  Chaque forage a une forageKey au format Asufor_<village>
    //  (ex. Asufor_diandioly, Asufor_ogo), stockée dans users/{uid}.forageKey.
    //
    //  Super-admin       : auth.token.email == 'prozizou298@gmail.com'
    //  Forage de l'appelant : root.child('users').child(auth.uid).child('forageKey').val()
    //  Rôle de l'appelant   : root.child('users').child(auth.uid).child('role').val()
    // ══════════════════════════════════════════════════════════════

    // ============ ANNUAIRE DES UTILISATEURS ============
    "users": {
      // Lecture du noeud entier (listing) : super-admin uniquement — nécessaire pour
      // l'écran super-admin (lister forages & présidents). Cascade vers tous les $uid.
      ".read": "auth != null && auth.token.email == 'prozizou298@gmail.com'",
      "$uid": {
        // Lecture individuelle : soi-même ; super-admin (déjà couvert ci-dessus) ; ou
        // président du même forage (voit son équipe).
        ".read": "auth != null && ( auth.uid == $uid || auth.token.email == 'prozizou298@gmail.com' || (root.child('users').child(auth.uid).child('role').val() == 'président' && root.child('users').child(auth.uid).child('forageKey').val() == data.child('forageKey').val()) )",

        // Écriture : super-admin (tout) ; ou président qui crée/gère un membre de SON forage
        // (jamais un super-admin, jamais un autre président).
        ".write": "auth != null && ( auth.token.email == 'prozizou298@gmail.com' || ( root.child('users').child(auth.uid).child('role').val() == 'président' && newData.child('forageKey').val() == root.child('users').child(auth.uid).child('forageKey').val() && newData.child('role').val() != 'superadmin' && newData.child('role').val() != 'président' ) )",

        ".validate": "newData.hasChildren(['role', 'forageKey'])",
        "role":       { ".validate": "newData.isString() && (newData.val() == 'président' || newData.val() == 'secrétaire' || newData.val() == 'trésorier' || newData.val() == 'agent')" },
        "forageKey":  { ".validate": "newData.isString() && newData.val().length > 0" },
        "login":      { ".validate": "newData.isString()" },
        "nom":        { ".validate": "newData.isString()" },
        "created_by": { ".validate": "newData.isString()" },
        "created_at": { ".validate": "newData.isString()" },
        "$other":     { ".validate": false }
      }
    },

    // ============ ASUFOR (données namespacées par village, forageKey = Asufor_<village>) ============
    "Asufor": {
      // Lecture du noeud entier (listing) : super-admin uniquement — nécessaire pour
      // l'écran super-admin (lister les forages existants). Cascade vers tous les $forageKey.
      ".read": "auth != null && auth.token.email == 'prozizou298@gmail.com'",
      "$forageKey": {
        // Lecture de tout le sous-arbre du forage : membre du forage ou super-admin
        // (déjà couvert ci-dessus).
        ".read": "auth != null && ( auth.token.email == 'prozizou298@gmail.com' || root.child('users').child(auth.uid).child('forageKey').val() == $forageKey )",

        // ── Config / branding : président du forage ou super-admin ──
        "config": {
          ".write": "auth != null && ( auth.token.email == 'prozizou298@gmail.com' || (root.child('users').child(auth.uid).child('forageKey').val() == $forageKey && root.child('users').child(auth.uid).child('role').val() == 'président') )"
        },

        // ── Agents (relevés terrain) ──
        "agents": {
          ".indexOn": ["agent_tel"],
          ".write": "auth != null && ( auth.token.email == 'prozizou298@gmail.com' || (root.child('users').child(auth.uid).child('forageKey').val() == $forageKey && (root.child('users').child(auth.uid).child('role').val() == 'président' || root.child('users').child(auth.uid).child('role').val() == 'secrétaire')) )",
          "$agentId": {
            ".validate": "newData.hasChildren(['agent', 'agent_tel', 'zone'])",
            "agent":     { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100" },
            "agent_tel": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{7,15}$/)" },
            "zone":      { ".validate": "newData.isString() && newData.val().length <= 100" },
            "$other":    { ".validate": true }
          }
        },

        // ── Compteurs / relevés (cycle courant) ──
        "compteurs": {
          "$recordId": {
            // Création : président/secrétaire du forage ou super-admin.
            // Mise à jour : + trésorier du forage.
            ".write": "auth != null && ( auth.token.email == 'prozizou298@gmail.com' || ( root.child('users').child(auth.uid).child('forageKey').val() == $forageKey && ( (!data.exists() && (root.child('users').child(auth.uid).child('role').val() == 'président' || root.child('users').child(auth.uid).child('role').val() == 'secrétaire')) || (data.exists() && (root.child('users').child(auth.uid).child('role').val() == 'président' || root.child('users').child(auth.uid).child('role').val() == 'secrétaire' || root.child('users').child(auth.uid).child('role').val() == 'trésorier')) ) ) )",
            "name":            { ".validate": "newData.isString() && newData.val().length <= 100" },
            "numero_compteur": { ".validate": "newData.isString()" },
            "new_index":       { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "last_index":      { ".validate": "newData.isString() || newData.isNumber()" },
            // ⚠️ Cf. commentaire équivalent sur asufor_db_diandioly ci-dessus : les
            // données réelles stockent souvent "facteur" en string.
            "facteur":         { ".validate": "newData.isNumber() || newData.isString()" },
            "$other":          { ".validate": true }
          }
        },

        // ── Archives de cycle (clôture / reset) : président du forage ou super-admin ──
        "backup": {
          ".write": "auth != null && ( auth.token.email == 'prozizou298@gmail.com' || (root.child('users').child(auth.uid).child('forageKey').val() == $forageKey && root.child('users').child(auth.uid).child('role').val() == 'président') )",
          "$cycle": {
            ".validate": "newData.hasChildren(['donnees'])"
          }
        },

        // ── Dépenses / caisse : président ou trésorier du forage, ou super-admin ──
        "depenses": {
          "$cycle": {
            ".write": "auth != null && ( auth.token.email == 'prozizou298@gmail.com' || (root.child('users').child(auth.uid).child('forageKey').val() == $forageKey && (root.child('users').child(auth.uid).child('role').val() == 'président' || root.child('users').child(auth.uid).child('role').val() == 'trésorier')) )",
            "$depId": {
              ".validate": "newData.hasChildren(['libelle', 'montant'])",
              "libelle": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120" },
              "montant": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "$other":  { ".validate": true }
            }
          }
        },

        // ── Annuaire de l'équipe (index léger, miroir de users/{uid}) ──
        // Nécessaire car les règles de "users" ne permettent PAS à un président de
        // lister le noeud entier (seul le super-admin le peut) : ce sous-noeud,
        // enfant de Asufor/{forageKey}, hérite du .read déjà accordé aux membres
        // du forage (cf. .read ci-dessus sur $forageKey), sans exposer les autres
        // forages. Écrit en même temps que users/{uid} par provisioning.js.
        "team": {
          "$uid": {
            ".write": "auth != null && ( auth.token.email == 'prozizou298@gmail.com' || (root.child('users').child(auth.uid).child('forageKey').val() == $forageKey && root.child('users').child(auth.uid).child('role').val() == 'président') )",
            ".validate": "newData.hasChildren(['role', 'nom'])",
            "role":  { ".validate": "newData.isString() && (newData.val() == 'président' || newData.val() == 'secrétaire' || newData.val() == 'trésorier')" },
            "nom":   { ".validate": "newData.isString()" },
            "login": { ".validate": "newData.isString()" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
