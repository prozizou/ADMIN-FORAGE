{
  "rules": {
    // ──────────────────────────────────────────────────────────────
    //  ASUFOR Diandioly — Règles de sécurité Realtime Database
    //  BROUILLON à TESTER avant déploiement (firebase deploy --only database)
    //
    //  Les rôles sont ici déduits de l'e-mail du compte Firebase Auth :
    //    président  -> president@diandioly.com
    //    secrétaire -> secretaire@diandioly.com
    //    trésorier  -> tresorier@diandioly.com
    //
    //  ⚠️  RECOMMANDATION : à terme, remplacer ces tests d'e-mail par des
    //      "custom claims" (auth.token.role == 'president', etc.) posés via
    //      l'Admin SDK / une Cloud Function. C'est plus robuste qu'un e-mail.
    // ──────────────────────────────────────────────────────────────

    // Refus par défaut : rien n'est lisible/inscriptible hors des noeuds déclarés.
    ".read": false,
    ".write": false,

    // ══════════════════════════════════════════════════════════════
    //  NŒUDS LEGACY (mono-forage Diandioly, avant migration multi-forage)
    //  db_agents, asufor_db_diandioly, asufor_backup, asufor_depenses,
    //  asufor_motivations : l'application n'y accède plus (ForageContext.LEGACY
    //  = false, données migrées sous Asufor/Asufor_diandioly/…). Ils restent en
    //  base jusqu'au retrait mais ne sont plus ouverts à « tout utilisateur
    //  authentifié » (un compte d'un AUTRE forage y lisait les données de
    //  Diandioly) : lecture = super-admin ou membre du forage Asufor_diandioly ;
    //  écriture = les e-mails historiques, ET membre du forage Asufor_diandioly.
    // ══════════════════════════════════════════════════════════════

    // ============ AGENTS (relevés terrain) ============
    "db_agents": {
      // Lecture : super-admin ou membre du forage Asufor_diandioly.
      ".read": "auth != null && ( auth.token.email == 'prozizou298@gmail.com' || root.child('users').child(auth.uid).child('forageKey').val() == 'Asufor_diandioly' )",

      // Écriture : création/gestion réservée au président et au secrétaire.
      ".write": "auth != null && root.child('users').child(auth.uid).child('forageKey').val() == 'Asufor_diandioly' && (auth.token.email == 'president@diandioly.com' || auth.token.email == 'secretaire@diandioly.com')",

      // Index requis par la vérification de doublon (orderByChild('agent_tel')).
      ".indexOn": ["agent_tel"],

      "$agentId": {
        // ✅ CORRECTION v5 : accepte 'passcode' (legacy, clair) OU 'passcode_hash'
        //    (nouveau format SHA-256), permettant la migration progressive des
        //    anciens agents sans casser leurs écritures.
        ".validate": "newData.hasChildren(['agent', 'agent_tel', 'zone']) && (newData.hasChild('passcode') || newData.hasChild('passcode_hash'))",
        "agent":      { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100" },
        "agent_tel":  { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{7,15}$/)" },
        // ⚠️  passcode legacy en clair : toléré jusqu'à migration complète (scripts/migrate-passcodes.js).
        "passcode":   { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{6}$/)" },
        // ✅ Nouveau format : hash SHA-256 hex (64 caractères).
        "passcode_hash": { ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)" },
        "zone":       { ".validate": "newData.isString() && newData.val().length <= 100" },
        "siege":      { ".validate": "newData.isString()" },
        "agent_id":   { ".validate": "newData.isString()" },
        // ⚠️  Données réelles : les 6 agents existants ont ce champ avec un ESPACE
        // ("agent id") au lieu de "agent_id" — un export Firebase confirmé l'a
        // montré. Toléré explicitement pour ne pas bloquer leurs futures écritures ;
        // les nouveaux agents créés par agents/agent.html utilisent "agent_id".
        "agent id":   { ".validate": "newData.isString()" },
        "key":        { ".validate": "newData.isString()" },
        "id_source":  { ".validate": "newData.isString()" },
        "created_at": { ".validate": "newData.isString()" },
        // Tout autre champ inattendu est refusé (verrouille le schéma agent).
        "$other":     { ".validate": false }
      }
    },

    // ============ COMPTEURS / RELEVÉS (cycle courant) ============
    "asufor_db_diandioly": {
      // Lecture : super-admin ou membre du forage Asufor_diandioly (legacy, voir plus haut).
      ".read": "auth != null && ( auth.token.email == 'prozizou298@gmail.com' || root.child('users').child(auth.uid).child('forageKey').val() == 'Asufor_diandioly' )",

      "$recordId": {
        // Création : président ou secrétaire uniquement.
        // Mise à jour (paiement, anomalie, archivage) : les trois rôles connus.
        ".write": "auth != null && root.child('users').child(auth.uid).child('forageKey').val() == 'Asufor_diandioly' && ( (!data.exists() && (auth.token.email == 'president@diandioly.com' || auth.token.email == 'secretaire@diandioly.com')) || (data.exists() && (auth.token.email == 'president@diandioly.com' || auth.token.email == 'secretaire@diandioly.com' || auth.token.email == 'tresorier@diandioly.com')) )",

        // Validation des champs critiques. Les autres champs applicatifs
        // (statut/status/facture/print/apaid/arrieres/anomaly_*/last_modified*…)
        // restent permis pour ne pas casser les écritures partielles existantes.
        "name":            { ".validate": "newData.isString() && newData.val().length <= 100" },
        "numero_compteur": { ".validate": "newData.isString()" },
        "new_index":       { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "last_index":      { ".validate": "newData.isString() || newData.isNumber()" },
        // ⚠️ Données réelles : ~2/3 des 417 compteurs stockent "facteur" en STRING
        // ("250") plutôt qu'en number — comme last_index ci-dessus, on tolère les
        // deux (billing.js le convertit systématiquement via toInt()).
        "facteur":         { ".validate": "newData.isNumber() || newData.isString()" },
        "tel":             { ".validate": "!newData.exists() || newData.val().matches(/^[0-9]{0,15}$/)" },
        "agent_id":        { ".validate": "newData.isString()" },
        "$other":          { ".validate": true }
      }
    },

    // ============ ARCHIVES DE CYCLE (reset/clôture) ============
    "asufor_backup": {
      // Lecture : super-admin ou membre du forage Asufor_diandioly (legacy, voir plus haut).
      ".read": "auth != null && ( auth.token.email == 'prozizou298@gmail.com' || root.child('users').child(auth.uid).child('forageKey').val() == 'Asufor_diandioly' )",
      // Écriture : président uniquement (opération irréversible de clôture).
      ".write": "auth != null && root.child('users').child(auth.uid).child('forageKey').val() == 'Asufor_diandioly' && auth.token.email == 'president@diandioly.com'",
      "$cycle": {
        ".validate": "newData.hasChildren(['donnees'])"
      }
    },

    // ============ DÉPENSES / CAISSE (par cycle "YYYY-MM") ============
    "asufor_depenses": {
      // Lecture : super-admin ou membre du forage Asufor_diandioly (legacy, voir plus haut).
      ".read": "auth != null && ( auth.token.email == 'prozizou298@gmail.com' || root.child('users').child(auth.uid).child('forageKey').val() == 'Asufor_diandioly' )",
      "$cycle": {
        // Écriture (ajout/suppression) : président et trésorier uniquement (finance).
        ".write": "auth != null && root.child('users').child(auth.uid).child('forageKey').val() == 'Asufor_diandioly' && (auth.token.email == 'president@diandioly.com' || auth.token.email == 'tresorier@diandioly.com')",
        "$depId": {
          ".validate": "newData.hasChildren(['libelle', 'montant'])",
          "libelle":    { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120" },
          "montant":    { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "date":       { ".validate": "newData.isString()" },
          "categorie":  { ".validate": "newData.isString()" },
          "created_by": { ".validate": "newData.isString()" },
          "created_at": { ".validate": "newData.isString()" },
          // Verrouille le schéma : tout autre champ est refusé.
          "$other":     { ".validate": false }
        }
      }
    },

    // ============ MOTIVATIONS DES AGENTS / BÉNÉFICIAIRES (par cycle "YYYY-MM") ============
    // Répartition d'une partie de l'encaissé du cycle entre les bénéficiaires
    // (président, trésorier, secrétaire, agents releveurs, programmeur, frais de
    // développement…) — le rapport affiche Encaissé − Σ(motivations) = Net.
    "asufor_motivations": {
      // Lecture : super-admin ou membre du forage Asufor_diandioly (legacy, voir plus haut).
      ".read": "auth != null && ( auth.token.email == 'prozizou298@gmail.com' || root.child('users').child(auth.uid).child('forageKey').val() == 'Asufor_diandioly' )",
      "$cycle": {
        // Écriture (ajout/suppression) : président et trésorier uniquement (finance).
        ".write": "auth != null && root.child('users').child(auth.uid).child('forageKey').val() == 'Asufor_diandioly' && (auth.token.email == 'president@diandioly.com' || auth.token.email == 'tresorier@diandioly.com')",
        "$motId": {
          ".validate": "newData.hasChildren(['beneficiaire', 'montant'])",
          "beneficiaire": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120" },
          "montant":      { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "role":         { ".validate": "newData.isString()" },
          "created_by":   { ".validate": "newData.isString()" },
          "created_at":   { ".validate": "newData.isString()" },
          // Verrouille le schéma : tout autre champ est refusé.
          "$other":       { ".validate": false }
        }
      }
    },

    // ══════════════════════════════════════════════════════════════
    //  MULTI-FORAGE — ADDITIF : les noeuds legacy ci-dessus restent actifs
    //  pour la connexion actuelle (Diandioly, tant que non migré). Ces
    //  noeuds préparent/portent la bascule (voir docs/MULTI-FORAGE.md).
    //
    //  Chaque forage a une forageKey au format Asufor_<village>
    //  (ex. Asufor_diandioly, Asufor_ogo), stockée dans users/{uid}.forageKey.
    //
    //  Super-admin       : auth.token.email == 'prozizou298@gmail.com'
    //  Forage de l'appelant : root.child('users').child(auth.uid).child('forageKey').val()
    //  Rôle de l'appelant   : root.child('users').child(auth.uid).child('role').val()
    // ══════════════════════════════════════════════════════════════

    // ============ ANNUAIRE DES UTILISATEURS ============
    "users": {
      // Lecture du noeud entier (listing) : super-admin uniquement — nécessaire pour
      // l'écran super-admin (lister forages & présidents). Cascade vers tous les $uid.
      ".read": "auth != null && auth.token.email == 'prozizou298@gmail.com'",
      "$uid": {
        // Lecture individuelle : soi-même ; super-admin (déjà couvert ci-dessus) ; ou
        // président du même forage (voit son équipe).
        ".read": "auth != null && ( auth.uid == $uid || auth.token.email == 'prozizou298@gmail.com' || (root.child('users').child(auth.uid).child('role').val() == 'président' && root.child('users').child(auth.uid).child('forageKey').val() == data.child('forageKey').val()) )",

        // Écriture : super-admin (tout) ; ou président qui crée/gère un membre de SON forage
        // (jamais un super-admin, jamais un président). ✅ ISOLATION : un compte EXISTANT ne
        // peut être modifié que s'il appartient DÉJÀ au forage du président — sinon un président
        // pouvait réécrire la fiche d'un utilisateur d'un autre forage (y compris son président)
        // en y posant sa propre forageKey pour le rattacher à son forage.
        ".write": "auth != null && ( auth.token.email == 'prozizou298@gmail.com' || ( root.child('users').child(auth.uid).child('role').val() == 'président' && newData.child('forageKey').val() == root.child('users').child(auth.uid).child('forageKey').val() && newData.child('role').val() != 'superadmin' && newData.child('role').val() != 'président' && ( !data.exists() || ( data.child('forageKey').val() == root.child('users').child(auth.uid).child('forageKey').val() && data.child('role').val() != 'président' ) ) ) )",

        ".validate": "newData.hasChildren(['role', 'forageKey'])",
        "role":       { ".validate": "newData.isString() && (newData.val() == 'président' || newData.val() == 'secrétaire' || newData.val() == 'trésorier' || newData.val() == 'agent')" },
        "forageKey":  { ".validate": "newData.isString() && newData.val().length > 0" },
        "login":      { ".validate": "newData.isString()" },
        "nom":        { ".validate": "newData.isString()" },
        "created_by": { ".validate": "newData.isString()" },
        "created_at": { ".validate": "newData.isString()" },
        "$other":     { ".validate": false }
      }
    },

    // ============ ASUFOR (données namespacées par village, forageKey = Asufor_<village>) ============
    "Asufor": {
      // Lecture du noeud entier (listing) : super-admin uniquement — nécessaire pour
      // l'écran super-admin (lister les forages existants). Cascade vers tous les $forageKey.
      ".read": "auth != null && auth.token.email == 'prozizou298@gmail.com'",
      "$forageKey": {
        // Lecture de tout le sous-arbre du forage : membre du forage ou super-admin
        // (déjà couvert ci-dessus).
        ".read": "auth != null && ( auth.token.email == 'prozizou298@gmail.com' || root.child('users').child(auth.uid).child('forageKey').val() == $forageKey )",

        // ── Config / branding : président du forage ou super-admin ──
        "config": {
          ".write": "auth != null && ( auth.token.email == 'prozizou298@gmail.com' || (root.child('users').child(auth.uid).child('forageKey').val() == $forageKey && root.child('users').child(auth.uid).child('role').val() == 'président') )",
          // ✅ CORRECTION v4 : next_counter_number — compteur atomique pour la numérotation des compteurs.
          //    Type number, >= 1, modifiable par président du forage ou super-admin.
          //    ✅ Le secrétaire (qui crée les compteurs, cf. counter/list.html) peut
          //    INCRÉMENTER ce compteur — jamais le faire reculer (doublons de numéros) ni
          //    écrire un autre champ de config (réservé au président).
          "next_counter_number": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('forageKey').val() == $forageKey && root.child('users').child(auth.uid).child('role').val() == 'secrétaire' && newData.isNumber() && ( !data.exists() || newData.val() >= data.val() )",
            ".validate": "newData.isNumber() && newData.val() >= 1"
          },
          // ✅ CORRECTION v4 : maintenance_passcode_hash — hash SHA-256 du passcode de maintenance.
          //    Stocké en hex 64 chars, jamais en clair dans la base.
          "maintenance_passcode_hash": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)"
          },
          // ✅ CORRECTION v4 : maintenance_passcode_cycle — mois de validité du passcode.
          "maintenance_passcode_cycle": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}$/)"
          },
          // Champs de branding existants (tolérés)
          "siege":          { ".validate": "newData.isString()" },
          "nom":            { ".validate": "newData.isString()" },
          "telephone":      { ".validate": "newData.isString()" },
          "logo":           { ".validate": "newData.isString()" },
          "$other":         { ".validate": true }
        },

        // ── Agents (relevés terrain) ──
        "agents": {
          ".indexOn": ["agent_tel"],
          ".write": "auth != null && ( auth.token.email == 'prozizou298@gmail.com' || (root.child('users').child(auth.uid).child('forageKey').val() == $forageKey && (root.child('users').child(auth.uid).child('role').val() == 'président' || root.child('users').child(auth.uid).child('role').val() == 'secrétaire')) )",
          "$agentId": {
            ".validate": "newData.hasChildren(['agent', 'agent_tel', 'zone'])",
            "agent":     { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100" },
            "agent_tel": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{7,15}$/)" },
            "zone":      { ".validate": "newData.isString() && newData.val().length <= 100" },
            // ✅ CORRECTION v4 : Accepter passcode_hash (SHA-256, 64 chars hex) pour les nouveaux agents.
            //    Le champ legacy 'passcode' (6 chiffres en clair) reste toléré pour les agents existants.
            "passcode_hash": { ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{64}$/)" },
            "passcode":       { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{6}$/)" },
            "siege":          { ".validate": "newData.isString()" },
            "agent_id":       { ".validate": "newData.isString()" },
            "agent id":       { ".validate": "newData.isString()" },
            "key":            { ".validate": "newData.isString()" },
            "id_source":      { ".validate": "newData.isString()" },
            "created_at":     { ".validate": "newData.isString()" },
            "$other":         { ".validate": false }
          }
        },

        // ── Compteurs / relevés (cycle courant) ──
        "compteurs": {
          "$recordId": {
            // Création : président/secrétaire du forage ou super-admin.
            // Mise à jour : + trésorier du forage.
            ".write": "auth != null && ( auth.token.email == 'prozizou298@gmail.com' || ( root.child('users').child(auth.uid).child('forageKey').val() == $forageKey && ( (!data.exists() && (root.child('users').child(auth.uid).child('role').val() == 'président' || root.child('users').child(auth.uid).child('role').val() == 'secrétaire')) || (data.exists() && (root.child('users').child(auth.uid).child('role').val() == 'président' || root.child('users').child(auth.uid).child('role').val() == 'secrétaire' || root.child('users').child(auth.uid).child('role').val() == 'trésorier')) ) ) )",
            "name":            { ".validate": "newData.isString() && newData.val().length <= 100" },
            "numero_compteur": { ".validate": "newData.isString()" },
            "new_index":       { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "last_index":      { ".validate": "newData.isString() || newData.isNumber()" },
            // ⚠️ Cf. commentaire équivalent sur asufor_db_diandioly ci-dessus : les
            // données réelles stockent souvent "facteur" en string.
            "facteur":         { ".validate": "newData.isNumber() || newData.isString()" },
            "$other":          { ".validate": true }
          }
        },

        // ── Archives de cycle (clôture / reset) ──
        //  • Le nœud entier n'est écrivable que par le super-admin.
        //  • ✅ CLÔTURE ATOMIQUE / ANTI-CONCURRENCE : le président ne peut CRÉER une archive de
        //    cycle qu'une seule fois (!data.exists()). La clôture écrit archive + remise à zéro
        //    des compteurs dans un seul update multi-chemins : si une autre clôture du même
        //    cycle est passée entre-temps, Firebase refuse TOUT (l'archive n'est jamais
        //    écrasée par des données déjà remises à zéro, les compteurs ne sont pas
        //    réinitialisés deux fois).
        //  • Corrections d'un relevé archivé (index, statut…) : président, ligne par ligne,
        //    sans pouvoir supprimer la ligne.
        //  • ✅ RÉGULARISATION : le trésorier peut modifier UNIQUEMENT les champs de paiement
        //    d'une ligne existante (statut, date, auteur) — jamais les index ni la structure.
        "backup": {
          ".write": "auth != null && auth.token.email == 'prozizou298@gmail.com'",
          "$cycle": {
            ".write": "auth != null && root.child('users').child(auth.uid).child('forageKey').val() == $forageKey && root.child('users').child(auth.uid).child('role').val() == 'président' && !data.exists()",
            ".validate": "newData.hasChildren(['donnees'])",
            "donnees": {
              "$recordId": {
                ".write": "auth != null && root.child('users').child(auth.uid).child('forageKey').val() == $forageKey && root.child('users').child(auth.uid).child('role').val() == 'président' && newData.exists()",
              "status": { ".write": "auth != null && root.child('users').child(auth.uid).child('forageKey').val() == $forageKey && (root.child('users').child(auth.uid).child('role').val() == 'président' || root.child('users').child(auth.uid).child('role').val() == 'trésorier') && data.parent().exists() && (newData.val() == 'paye' || newData.val() == 'impaye')" },
              "statut": { ".write": "auth != null && root.child('users').child(auth.uid).child('forageKey').val() == $forageKey && (root.child('users').child(auth.uid).child('role').val() == 'président' || root.child('users').child(auth.uid).child('role').val() == 'trésorier') && data.parent().exists() && newData.isBoolean()" },
              "date_paiement": { ".write": "auth != null && root.child('users').child(auth.uid).child('forageKey').val() == $forageKey && (root.child('users').child(auth.uid).child('role').val() == 'président' || root.child('users').child(auth.uid).child('role').val() == 'trésorier') && data.parent().exists() && (!newData.exists() || newData.isString())" },
              "last_modified_by": { ".write": "auth != null && root.child('users').child(auth.uid).child('forageKey').val() == $forageKey && (root.child('users').child(auth.uid).child('role').val() == 'président' || root.child('users').child(auth.uid).child('role').val() == 'trésorier') && data.parent().exists() && newData.isString()" },
              "last_modified_at": { ".write": "auth != null && root.child('users').child(auth.uid).child('forageKey').val() == $forageKey && (root.child('users').child(auth.uid).child('role').val() == 'président' || root.child('users').child(auth.uid).child('role').val() == 'trésorier') && data.parent().exists() && newData.isString()" }
              }
            }
          }
        },

        // ── Dépenses / caisse : président ou trésorier du forage, ou super-admin ──
        "depenses": {
          "$cycle": {
            ".write": "auth != null && ( auth.token.email == 'prozizou298@gmail.com' || (root.child('users').child(auth.uid).child('forageKey').val() == $forageKey && (root.child('users').child(auth.uid).child('role').val() == 'président' || root.child('users').child(auth.uid).child('role').val() == 'trésorier')) )",
            "$depId": {
              ".validate": "newData.hasChildren(['libelle', 'montant'])",
              "libelle": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120" },
              "montant": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "$other":  { ".validate": true }
            }
          }
        },

        // ── Motivations des agents/bénéficiaires : président ou trésorier du forage, ou super-admin ──
        "motivations": {
          "$cycle": {
            ".write": "auth != null && ( auth.token.email == 'prozizou298@gmail.com' || (root.child('users').child(auth.uid).child('forageKey').val() == $forageKey && (root.child('users').child(auth.uid).child('role').val() == 'président' || root.child('users').child(auth.uid).child('role').val() == 'trésorier')) )",
            "$motId": {
              ".validate": "newData.hasChildren(['beneficiaire', 'montant'])",
              "beneficiaire": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120" },
              "montant": { ".validate": "newData.isNumber() && newData.val() >= 0" },
              "$other":  { ".validate": true }
            }
          }
        },

        // ── Annuaire de l'équipe (index léger, miroir de users/{uid}) ──
        // Nécessaire car les règles de "users" ne permettent PAS à un président de
        // lister le noeud entier (seul le super-admin le peut) : ce sous-noeud,
        // enfant de Asufor/{forageKey}, hérite du .read déjà accordé aux membres
        // du forage (cf. .read ci-dessus sur $forageKey), sans exposer les autres
        // forages. Écrit en même temps que users/{uid} par provisioning.js.
        "team": {
          "$uid": {
            ".write": "auth != null && ( auth.token.email == 'prozizou298@gmail.com' || (root.child('users').child(auth.uid).child('forageKey').val() == $forageKey && root.child('users').child(auth.uid).child('role').val() == 'président') )",
            ".validate": "newData.hasChildren(['role', 'nom'])",
            "role":  { ".validate": "newData.isString() && (newData.val() == 'président' || newData.val() == 'secrétaire' || newData.val() == 'trésorier')" },
            "nom":   { ".validate": "newData.isString()" },
            "login": { ".validate": "newData.isString()" },
            "$other": { ".validate": false }
          }
        },

        // ✅ CORRECTION v4 : Journal d'audit des modifications d'arriérés.
        //    Écriture par tout membre authentifié du forage (pour tracer qui a modifié quoi).
        //    Lecture uniquement par président et super-admin.
        "audit_arrieres": {
          // ✅ ISOLATION : le président ne lit que le journal de SON forage (avant : n'importe quel forage).
          ".read": "auth != null && ( auth.token.email == 'prozizou298@gmail.com' || ( root.child('users').child(auth.uid).child('role').val() == 'président' && root.child('users').child(auth.uid).child('forageKey').val() == $forageKey ) )",
          "$entryId": {
            ".write": "auth != null && ( auth.token.email == 'prozizou298@gmail.com' || (root.child('users').child(auth.uid).child('forageKey').val() == $forageKey && (root.child('users').child(auth.uid).child('role').val() == 'président' || root.child('users').child(auth.uid).child('role').val() == 'secrétaire' || root.child('users').child(auth.uid).child('role').val() == 'trésorier')) )",
            ".validate": "newData.hasChildren(['compteurKey', 'compteur', 'proprietaire', 'zone', 'ancienArrieres', 'nouveauArrieres', 'modifiePar', 'modifieRole', 'modifieLe', 'sessionForage'])",
            "compteurKey":     { ".validate": "newData.isString()" },
            "compteur":        { ".validate": "newData.isString()" },
            "proprietaire":    { ".validate": "newData.isString()" },
            "zone":            { ".validate": "newData.isString()" },
            "ancienArrieres":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "nouveauArrieres": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "modifiePar":      { ".validate": "newData.isString()" },
            "modifieRole":     { ".validate": "newData.isString()" },
            "modifieLe":       { ".validate": "newData.isString()" },
            "sessionForage":   { ".validate": "newData.isString()" },
            "$other":          { ".validate": false }
          }
        }
      }
    }
  }
}
